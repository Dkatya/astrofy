---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

// Group by category, preserving the order field
const grouped: Record<string, typeof projects> = {};
for (const p of projects) {
  const cat = p.data.category ?? "Other";
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(p);
}

// Render category sections in a stable order
const categoryOrder = ["Research", "Applied ML", "Other"];
const orderedCategories = [
  ...categoryOrder.filter((c) => grouped[c]),
  ...Object.keys(grouped).filter((c) => !categoryOrder.includes(c)),
];

function projectUrl(p: (typeof projects)[number]) {
  return p.data.externalUrl ?? `/projects/${p.slug}`;
}
function projectTarget(p: (typeof projects)[number]) {
  return p.data.externalUrl ? "_blank" : "_self";
}
---

<BaseLayout title="Projects" activeNav="projects">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Projects</h1>
    <p class="opacity-80">
      A mix of group research, applied-ML coursework, and personal side projects. Detail pages where
      there's a real story to tell; everything else links straight to the code.
    </p>
  </div>

  {
    orderedCategories.map((cat) => (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3">{cat}</h2>
        {grouped[cat].map((p, i) => (
          <>
            <HorizontalCard
              title={p.data.title}
              img={p.data.image ?? "/post_img.webp"}
              desc={p.data.description}
              url={projectUrl(p)}
              target={projectTarget(p)}
              badge={p.data.badge}
            />
            {i < grouped[cat].length - 1 && <div class="divider my-0" />}
          </>
        ))}
      </section>
    ))
  }
</BaseLayout>

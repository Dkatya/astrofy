---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Services" activeNav="services">
  <h1 class="text-3xl font-bold mb-4">Services</h1>
  <p class="opacity-80 leading-relaxed mb-6">
    Open to data-science and ML consulting work — short scoped engagements rather than long retainers.
    Currently focused on coursework and capstone research, so availability is limited; happy to
    chat about a problem and point you somewhere useful even if it isn't me.
  </p>
  <p class="leading-relaxed">
    Drop me a line at
    <a class="link" href="mailto:contact@yekaterinadonegal.dev">contact@yekaterinadonegal.dev</a>
    with a short description of what you're trying to figure out.
  </p>
</BaseLayout>

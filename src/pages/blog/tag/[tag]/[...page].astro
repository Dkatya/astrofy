---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../../../../lib/createSlug";

export async function getStaticPaths({ paginate }) {
  const all_posts = await getCollection("blog");
  const all_tags = [
    ...new Set(all_posts.flatMap((post) => post.data.tags || [])),
  ];

  return all_tags.flatMap((tag) => {
    const filtered_posts = all_posts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(filtered_posts, {
      params: { tag },
      pageSize: 20,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;

const dateFmt = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title={"Tag: " + params.tag} activeNav="blog">
  <div class="mb-6">
    <a href="/blog" class="text-sm opacity-80 hover:opacity-100">← All posts</a>
  </div>
  <h1 class="text-3xl font-bold mb-6">Tag: <span class="opacity-80">{params.tag}</span></h1>

  {
    page.data.length === 0 ? (
      <p class="opacity-70">No posts with this tag yet.</p>
    ) : (
      <ul class="divide-y divide-base-300">
        {page.data.map((post) => (
          <li class="py-3 flex items-baseline gap-4">
            <time class="font-mono text-sm opacity-70 shrink-0 tabular-nums">
              {dateFmt.format(post.data.pubDate)}
            </time>
            <a
              class="hover:underline"
              href={"/blog/" + createSlug(post.data.title, post.slug)}
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <div class="flex justify-between mt-8 text-sm">
    {page.url.prev ? <a href={page.url.prev} class="link">← Newer</a> : <div />}
    {page.url.next ? <a href={page.url.next} class="link">Older →</a> : <div />}
  </div>
</BaseLayout>
